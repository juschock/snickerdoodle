# Checkout and webhook intake are separate operational switches. Keep them
# false in development unless running an exact approved test configuration.
SNICKERDOODLE_PAYMENTS_ENABLED=false
SNICKERDOODLE_PAYMENT_WEBHOOKS_ENABLED=false
SNICKERDOODLE_STRIPE_LIVEMODE=false
SNICKERDOODLE_ANALYTICS_ENABLED=false

# Commercial public/intake mode opens only when every value below is exactly true.
# Keep all false until the corresponding approval evidence exists. Setting these
# deployment flags records approvals; it does not grant them.
SNICKERDOODLE_COMMERCIAL_READY=false
SNICKERDOODLE_OFFER_APPROVED=false
SNICKERDOODLE_FULFILLMENT_READY=false
SNICKERDOODLE_REVIEWER_READY=false
SNICKERDOODLE_LEGAL_APPROVED=false
SNICKERDOODLE_PAYMENTS_READY=false
SNICKERDOODLE_G5_ASSIGNED=false
SNICKERDOODLE_MONETARY_APPROVED=false

CHECKOUT_SECURITY_SECRET=
SNICKERDOODLE_ALLOWED_ORIGIN=https://racoben.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key used only with the caller's owner JWT for the metadata-only manager queue.
SUPABASE_ANON_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
