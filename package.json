{
  "name": "snickerdoodle",
  "version": "1.0.5",
  "private": true,
  "description": "Snickerdoodle by Racoben — campaign execution packages at racoben.com/snickerdoodle",
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev -p 3102",
    "build": "next build --webpack",
    "build:gate-true-test": "SNICKERDOODLE_COMMERCIAL_READY=true SNICKERDOODLE_OFFER_APPROVED=true SNICKERDOODLE_FULFILLMENT_READY=true SNICKERDOODLE_REVIEWER_READY=true SNICKERDOODLE_LEGAL_APPROVED=true SNICKERDOODLE_PAYMENTS_READY=true SNICKERDOODLE_G5_ASSIGNED=true SNICKERDOODLE_MONETARY_APPROVED=true next build --webpack",
    "start": "next start -p 3102",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:hold": "npm run build:gate-true-test && playwright test --config=playwright.hold.config.ts",
    "test:e2e:hold:built": "playwright test --config=playwright.hold.config.ts",
    "test:e2e:built": "playwright test",
    "security:secrets": "./scripts/security/scan-secrets.sh --all",
    "security:secrets:staged": "./scripts/security/scan-secrets.sh --staged",
    "brief:invite": "node scripts/create-brief-access-link.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/supabase-js": "^2.110.5",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.4.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "shadcn": "4.19.0",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  }
}
